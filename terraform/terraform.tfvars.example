# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control

# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"

# Repository Configuration
ecr_repository_name  = "langchain-sql-lambda"
lambda_function_name = "langchain-sql-query"

# Lambda Configuration
lambda_timeout     = 60
lambda_memory_size = 512

# OpenAI API Key (required)
# Get from: https://platform.openai.com/api-keys
openai_api_key = "sk-proj-your-api-key-here"

# CloudWatch Logs
log_retention_days = 7

# GitHub Actions OIDC (set to false to disable)
enable_github_oidc = true
# Format: "owner/repository"
# Example: "rchadha/langchain-llm-sql"
github_repository = "your-github-username/your-repo-name"

# API Gateway (set to false to disable HTTP access)
enable_api_gateway = true
api_gateway_stage_name = "prod"

# CORS Configuration for API Gateway
# Use ["*"] to allow all origins, or specify domains like:
# api_gateway_cors_origins = ["https://example.com", "https://app.example.com"]
api_gateway_cors_origins = ["*"]
